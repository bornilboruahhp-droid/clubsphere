enum NotificationType {
  CLUB_REVIEW_REQUESTED
  CLUB_DECISION
  MEMBERSHIP_REQUEST
  MEMBERSHIP_DECISION
  ROLE_CHANGED
  EVENT_PUBLISHED
  EVENT_CANCELLED
  ANNOUNCEMENT
  ELECTION_UPDATE
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}
